{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Fino-wind/vaultbeat-apple-health",
  "description": "Your AI agent reads your Apple Health data: sleep, HRV, cycle, workouts. Decrypted on your machine",
  "repository": {
    "url": "https://github.com/Fino-wind/vaultbeat-apple-health",
    "source": "github"
  },
  "version": "0.9.2",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "vaultbeat-apple-health",
      "version": "0.9.2",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        },
        {
          "type": "named",
          "name": "--transport",
          "value": "stdio"
        }
      ]
    }
  ]
}
